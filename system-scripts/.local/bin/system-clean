#!/usr/bin/env bash


# color formatting
BOLD_WARNING=$'\033[1;33m'
BOLD_SUCCESS=$'\033[1;32m'
RESET_FORMATTING=$'\033[0m'


# body
printf '\n%sStarting system cleanup!%s\n' \
    "$BOLD_WARNING" "$RESET_FORMATTING"

rm -rf "$HOME"/Downloads/*

rm -rf /tmp/*

# clean dns history
sudo resolvectl flush-caches

rm -f "$HOME"/.bash_history
rm -f "$HOME"/.python_history

touch "$HOME"/.bash_history
touch "$HOME"/.python_history

history -c

clear
printf '\n%sFinished system cleanup.%s\n' \
    "$BOLD_SUCCESS" "$RESET_FORMATTING"
